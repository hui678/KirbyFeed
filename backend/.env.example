# ── 对象存储（阿里云 OSS，可选）──
# 不设置 OBJECT_STORAGE_ENABLED 时回落本地磁盘 .run/uploads，行为与改造前一致。
# 启用后，视频/封面/头像与分片上传都走 OSS，读取用「私有桶 + 预签名 URL」。

# 设为 1 开启 OSS（默认不开启）
OBJECT_STORAGE_ENABLED=0

# provider 目前固定为 oss
OSS_PROVIDER=oss

# OSS Endpoint，形如 https://oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT=

# 桶名
OSS_BUCKET=

# 地域（可选，仅作记录）
OSS_REGION=

# 访问凭证
OSS_ACCESS_KEY=
OSS_SECRET_KEY=

# 预签名 URL 有效期（秒，默认 3600）
OSS_PRESIGN_TTL=3600
